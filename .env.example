# Αντίγραψε αυτό το αρχείο σε .env και βάλε τα πραγματικά keys σου
# cp .env.example .env

# The Odds API — δωρεάν 500 req/μήνα
# Εγγραφή: https://the-odds-api.com
ODDS_API_KEY=your_key_here

# Football-data.org — δωρεάν 100 req/μέρα
# Εγγραφή: https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=your_key_here

# Bankroll σε ευρώ για Kelly Criterion
BANKROLL=1000
